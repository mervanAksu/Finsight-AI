# Bu dosyayı .env adıyla kopyalayıp doldurun. .env git'e eklenmez.
# SEC tanımlayıcı User-Agent ister: uygulama adı + ad soyad + e-posta
SEC_USER_AGENT=FinSight-AI Ad Soyad eposta@ornek.com
# Saniyedeki en fazla SEC isteği (SEC sınırı 10; 8 önerilir)
SEC_MAX_RPS=8
POSTGRES_PASSWORD=finsight_dev

# --- Soru-cevap için LLM (isteğe bağlı; yoksa cevaplar alıntı/çıkarımsal modda üretilir) ---
# Sağlayıcı: anthropic | openai | none (boşsa anahtara göre otomatik seçilir)
FINSIGHT_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI uyumlu yerel sunucu için (ör. http://localhost:11434/v1); anahtar gerekmeyebilir
OPENAI_BASE_URL=
# Model adı (varsayılan: anthropic → claude-haiku-5-5, openai → gpt-4o-mini)
FINSIGHT_LLM_MODEL=

# --- Duygu ve gömme modelleri (ML paketleri isteğe bağlı: backend/requirements-ml.txt) ---
# lexicon → FinBERT yerine sözlük modelini zorla (hızlı, ML paketi gerekmez)
FINSIGHT_SENTIMENT_MODEL=
# hashing → sentence-transformers yerine hashing gömücüsünü zorla
FINSIGHT_EMBEDDER=
# Varsayılan: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FINSIGHT_EMBEDDING_MODEL=
# Loughran-McDonald Master Dictionary CSV yolu (verilirse sözlük modeli bunu kullanır)
LM_DICTIONARY_PATH=

# --- Sunucu ---
# Ek CORS kökenleri (virgülle); 127.0.0.1:5173 ve localhost:5173 her zaman izinli
FINSIGHT_CORS_ORIGINS=
# Derlenmiş arayüz klasörü (verilmezse depo kökündeki frontend/dist; Docker imajında
# /app/frontend_dist). Docker'da boş bırakmayın, satırı yorumda tutun:
# FINSIGHT_FRONTEND_DIST=/yol/frontend/dist
# İndirilen 10-K/10-Q belgeleri (varsayılan: $SEC_CACHE_DIR/documents)
# FINSIGHT_DOCUMENTS_DIR=/yol/belgeler
